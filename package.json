    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@testing-library/jest-dom": "^6.4.3",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
